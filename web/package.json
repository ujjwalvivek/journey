{
  "name": "web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../game --target web --out-dir pkg --release",
    "build:wasm:dev": "wasm-pack build ../game --target web --out-dir pkg --dev",
    "dev": "npm run build:wasm:dev && vite",
    "dev:quick": "vite",
    "build": "npm run build:wasm && tsc && vite build",
    "build:quick": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "wasm-pack": "^0.14.0"
  }
}
